# /srv/bath-studio/.env on the server (chmod 600). server-setup.sh creates it from this file.
# Never commit the real file.

# Public address of the app (DNS A record -> the server's Elastic IP)
BSS_DOMAIN=studio.example.com
# Let's Encrypt account e-mail (expiry notices)
ACME_EMAIL=devops@example.com

# Required to create the first admin on a fresh server. Give it only to the person who will be admin.
# Has no effect once an admin exists; you may blank it afterwards.
BSS_SETUP_TOKEN=change-me-long-random

# Login cookie only over HTTPS
BSS_SECURE_COOKIES=1

# Nightly backups (backup.sh)
AWS_REGION=ap-south-1
BACKUP_BUCKET=bath-studio-backups-ACCOUNTID
KEEP_LOCAL_BACKUPS=7

# Written by deploy.sh on every deploy - do not edit by hand
BSS_IMAGE=
